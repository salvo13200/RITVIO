{
  "name": "ritvio",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "test": "tsx --test tests/*.test.ts",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "i18n:sync": "node scripts/sync-localization.mjs",
    "i18n:check": "node scripts/sync-localization.mjs --check",
    "check:locales": "node scripts/check-locales.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:ui": "playwright test",
    "test:desktop": "node tests/desktop-live.mjs",
    "test:package": "node tests/packaged-desktop.mjs",
    "test:installer": "node tests/installer-lifecycle.mjs",
    "check:resolver": "tsx scripts/check-resolver.ts",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "setup:resolver": "node scripts/setup-resolver.mjs",
    "package:windows": "node scripts/build-icon.mjs && pnpm build && node scripts/package-windows.mjs",
    "test:ui3": "playwright test --config tests/config/playwright.ui3.config.ts",
    "test:ui4": "playwright test --config tests/config/playwright.ui4.config.ts",
    "test:controls": "playwright test --config tests/config/playwright.controls.config.ts",
    "test:ui5": "playwright test --config tests/config/playwright.ui5.config.ts",
    "test:ui6": "playwright test --config tests/config/playwright.ui6.config.ts",
    "test:motion": "playwright test --config tests/config/playwright.motion.config.ts",
    "test:motion:regression": "playwright test --config tests/config/playwright.motion-regression.config.ts",
    "test:accessibility": "playwright test --config tests/config/playwright.accessibility.config.ts",
    "test:accessibility:regression": "playwright test --config tests/config/playwright.accessibility-regression.config.ts",
    "test:performance": "playwright test --config tests/config/playwright.performance.config.ts",
    "test:performance:regression": "playwright test --config tests/config/playwright.performance-regression.config.ts",
    "test:playback": "playwright test --config tests/config/playwright.playback.config.ts",
    "measure:playback": "tsx scripts/measure-playback.ts",
    "android:setup": "powershell -NoProfile -File scripts/setup-android.ps1",
    "android:build": "node scripts/build-android.mjs",
    "android:test:ui": "playwright test --config tests/config/playwright.android10.config.ts",
    "licenses:collect": "node scripts/collect-licenses.mjs",
    "release:check": "node scripts/public-source.mjs",
    "release:source": "node scripts/public-source.mjs --export",
    "funding:configure": "node scripts/configure-funding.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@fastify/cors": "11.3.1",
    "@fastify/static": "8.3.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.5",
    "i18next": "26.4.7",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.20",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.25.0"
}
